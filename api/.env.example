# ── BandMuft API env ──────────────────────────────────
# Jhon: apni keys yahan paste karo (Render dashboard → Environment).
# Repo mein kabhi asal keys mat daalo.

PORT=4000
NODE_ENV=development

# MongoDB Atlas — naya database "bandmuft" (FYP wale se alag)
MONGODB_URI=PASTE_YOUR_MONGODB_URI_HERE

# JWT — lambi random strings (kam az kam 32 characters)
JWT_ACCESS_SECRET=PASTE_RANDOM_32CHAR_STRING_HERE
JWT_REFRESH_SECRET=PASTE_ANOTHER_RANDOM_32CHAR_STRING_HERE

# Frontend ka URL (CORS allowlist) — local dev ya Vercel URL
WEB_URL=http://localhost:3000

# Resend — emails (OTP, password reset) ke liye
RESEND_API_KEY=PASTE_YOUR_RESEND_API_KEY_HERE
MAIL_FROM=BandMuft <onboarding@resend.dev>

# Gemini — AI writing/speaking feedback ke liye (baad ka phase)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# (optional) Gemini model override — default: gemini-2.5-flash
GEMINI_MODEL=

# Admin / contact — contact form ke messages is email par ayenge
# (khaali choro to ADMIN_EMAIL par jayenge)
CONTACT_TO=
